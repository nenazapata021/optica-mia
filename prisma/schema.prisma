generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = []
}

enum PaymentProvider {
  WOMPI
  ADDI
  SISTECREDITO
}

enum OrderStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
}

datasource db {
  provider = "postgresql"
}

enum ImageAngle {
  FRONTAL
  LATERAL_DERECHO
  LATERAL_IZQUIERDO
  TRES_CUARTOS
  DETALLE
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Float
  image       String
  categoria   String
  descripcion String  @default("")
  color       String?
  modelo      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]
  favorites  Favorite[]
  motor      Motor?
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  angle     ImageAngle @default(FRONTAL)
  alt       String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([productId, sortOrder])
  @@unique([productId, sortOrder])
  @@map("product_images")
}

model User {
  id                   String    @id @default(cuid())
  nombre               String
  email                String    @unique
  passwordHash         String?   @map("password_hash")
  role                 String    @default("customer")
  telefono             String?
  direccion            String?
  hasCompletedOnboarding Boolean  @default(false)
  emailVerified        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders               Order[]
  favorites            Favorite[]
  photos               ClientPhoto[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model ClientPhoto {
  id         String   @id @default(cuid())
  storageKey String   @unique
  url        String
  mimeType   String   @default("image/png")
  sizeBytes  Int
  width      Int      @default(1024)
  height     Int      @default(1024)
  data       Bytes
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("client_photos")
  @@index([userId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])

  totalInCents    Float       @map("total")
  customerName    String      @default("")
  customerEmail   String      @default("")
  customerPhone   String      @default("")
  customerCity    String      @default("")

  cityValidated   Boolean     @default(false)

  paymentProvider PaymentProvider
  paymentMethod   String?
  externalId      String?
  status          String      @default("PENDING")

  transactionId   String?     @unique
  wompiStatus     String?
  createdAt       DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@index([orderId])
  @@index([productId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Sede {
  id        String   @id @default(cuid())
  nombre    String
  direccion String
  lat       Float
  lng       Float
  horario   String   @default("Lunes a Sábados 8:00 - 18:00")
  telefono  String?
  createdAt DateTime @default(now())
}

enum MonturaCategoria {
  FORMULA
  SOL
}

model Montura {
  id              String           @id @default(cuid())
  referencia      String           @unique
  marca           String?
  nombre          String
  categoria       MonturaCategoria
  forma           String
  color           String
  precio          Decimal          @db.Decimal(10, 2)
  imagenPrincipal String
  imagenes        String[]
  tags            String[]
  stock           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Motor {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  marca             String?
  forma             String   @default("Redonda")
  tags              String[]
  badge             String?

  imagenCatalogoUrl String
  imagenOverlayUrl  String

  anchoRealMm       Float
  anchoImagenPx     Int
  offsetXPx         Float    @default(0)
  offsetYPx         Float    @default(0)
  anguloBaseGrados  Float    @default(0)

  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}