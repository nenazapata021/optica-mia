# NEXT.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Base de datos
POSTGRES_USER=optica
POSTGRES_PASSWORD=optica
POSTGRES_DB=optica_mia
DATABASE_URL=postgresql://optica:optica@postgres:5432/optica_mia?schema=public

# Wompi (Sandbox por defecto)
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_sandbox_xxx
WOMPI_PRIVATE_KEY=prv_sandbox_xxx
WOMPI_INTEGRITY_KEY=int_sandbox_xxx
WOMPI_EVENT_SECRET=evt_sandbox_xxx

# Addi - obtener tras ser aprobado como aliado e-commerce
ADDI_API_BASE_URL=https://api.addi.mx
ADDI_PUBLIC_KEY=pk_live_xxx
ADDI_SECRET_KEY=sk_live_xxx

# Sistecredito - obtener tras ser aprobado como aliado e-commerce
SISTECREDITO_API_BASE_URL=https://api.sistecredito.co
SISTECREDITO_PUBLIC_KEY=pk_live_xxx
SISTECREDITO_SECRET_KEY=sk_live_xxx

# Configuración de negocio
NODE_ENV=production
RUN_SEED=false
ADMIN_EMAIL=admin@optica-mia.com