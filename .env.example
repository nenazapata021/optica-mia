# Database (auto-provided by Render when linking PostgreSQL service)
DATABASE_URL=postgresql://user:pass@host:5432/dbname
POSTGRES_HOST=host
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_DB=dbname

# App
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
RUN_SEED=false

# Wompi (Production keys from https://dashboard.wompi.co)
WOMPI_PRIVATE_KEY=prv_prod_...
WOMPI_PUBLIC_KEY=pub_prod_...
WOMPI_INTEGRITY_SECRET=...

# Addi (Production keys from Addi dashboard)
ADDI_CLIENT_ID=...
ADDI_CLIENT_SECRET=...

# Sistecrédito (Production keys from Sistecrédito dashboard)
SISTECREDITO_CLIENT_ID=...
SISTECREDITO_CLIENT_SECRET=...

# Google Maps (for store locator)
GOOGLE_MAPS_API_KEY=...

# Public keys (safe to expose to browser)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_prod_...
NEXT_PUBLIC_ADDI_CLIENT_ID=...
NEXT_PUBLIC_SISTECREDITO_CLIENT_ID=...

# Auth.js v5 (NextAuth v5)
AUTH_URL=https://optica-mia-web-production.up.railway.app
AUTH_TRUST_HOST=true
AUTH_SECRET=CdSL/jSXV592gLDoHWHhOjMF5nwAOI2TMqcR0Bgap2A=
NEXTAUTH_URL=https://optica-mia-web-production.up.railway.app
NEXTAUTH_SECRET=CdSL/jSXV592gLDoHWHhOjMF5nwAOI2TMqcR0Bgap2A