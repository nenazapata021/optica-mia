# NEXT.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Base de datos
POSTGRES_USER=optica
POSTGRES_PASSWORD=optica
POSTGRES_DB=optica_mia
DATABASE_URL=postgresql://optica:optica@postgres:5432/optica_mia?schema=public

# Wompi (Sandbox por defecto)
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_sandbox_xxx
WOMPI_PRIVATE_KEY=prv_sandbox_xxx
WOMPI_INTEGRITY_KEY=int_sandbox_xxx
WOMPI_EVENT_SECRET=evt_sandbox_xxx

# Addi - obtener tras ser aprobado como aliado e-commerce
ADDI_API_BASE_URL=https://api.addi.mx
ADDI_CLIENT_ID=client_xxx
ADDI_CLIENT_SECRET=sk_live_xxx
ADDI_ENV=sandbox|production

# Sistecredito - obtener tras ser aprobado como aliado e-commerce
SISTECREDITO_API_BASE_URL=https://api.sistecredito.co
SISTECREDITO_CLIENT_ID=client_xxx
SISTECREDITO_CLIENT_SECRET=sk_live_xxx
SISTECREDITO_ENV=sandbox|production

# Bre-B — Llave configurable para pagos Bre-B (visible en checkout)
# Cambia este valor y reconstruye la app (NEXT_PUBLIC_ se inyecta en build). No hardcodear en TSX.
# Ejemplo: @MGA313 o tu llave asignada por el banco
NEXT_PUBLIC_BREB_KEY=@MGA313

# Seguridad — NUNCA commitear .env real; usar Docker secrets o Vault en prod
AUTH_SECRET=cambia-esto-32-chars-minimo-en-produccion
# Configuración de negocio
NODE_ENV=production
RUN_SEED=false
ADMIN_EMAIL=admin@optica-mia.com
# Habilitar HSTS solo con HTTPS: AUTO en prod
NEXT_PUBLIC_SITE_URL=https://opticamia.com.co